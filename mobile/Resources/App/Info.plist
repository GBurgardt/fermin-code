<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Fermín Code</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.fermincode.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kycode</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>FerminCodeAppGroup</key>
	<string>$(FERMIN_CODE_APP_GROUP)</string>
	<key>FerminCodePrimaryRelayURL</key>
	<string>$(FERMIN_CODE_PRIMARY_RELAY_URL)</string>
	<key>FerminCodeSecondaryRelayURL</key>
	<string>$(FERMIN_CODE_SECONDARY_RELAY_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_kycode._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your KyCode desktop on the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a short voice prompt to craft your reply.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribe your spoken prompt into text.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>BackgroundColor</string>
	</dict>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
